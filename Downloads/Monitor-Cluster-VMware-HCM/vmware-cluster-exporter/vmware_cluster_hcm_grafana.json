{
  "title": "VMWARE CLUSTER HCM",
  "uid": "vmware-cluster-hcm",
  "tags": [
    "vmware",
    "vsan",
    "cluster",
    "vmware-cluster-exporter"
  ],
  "description": "Tổng quan từng cluster VMware: trạng thái, DRS, host, VM, CPU/RAM, vSAN, resync, host cao nhất.",
  "timezone": "browser",
  "editable": true,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(vmware_cluster_hosts, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(vmware_cluster_hosts, cluster)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "VMWARE CLUSTER HCM",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "$cluster",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "repeat": "cluster",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 9
      },
      "links": [
        {
          "title": "Chi tiết host của $cluster",
          "url": "/d/esxi-host-resource/?var-cluster=$cluster&${datasource:queryparam}"
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max(vmware_cluster_vsan_health{cluster=\"$cluster\"}) or max(vmware_cluster_status{cluster=\"$cluster\"})",
          "legendFormat": "Cluster Status",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "max(vmware_cluster_drs_mode{cluster=\"$cluster\"})",
          "legendFormat": "DRS",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "max(vmware_cluster_hosts{cluster=\"$cluster\"})",
          "legendFormat": "Total Host",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "max(vmware_cluster_vms_total{cluster=\"$cluster\"})",
          "legendFormat": "Total VM",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "max(vmware_cluster_cpu_total_hz{cluster=\"$cluster\"})",
          "legendFormat": "CPU Total",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F",
          "expr": "max(vmware_cluster_cpu_used_hz{cluster=\"$cluster\"}) / max(vmware_cluster_cpu_total_hz{cluster=\"$cluster\"}) * 100",
          "legendFormat": "CPU Used",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "G",
          "expr": "max(vmware_cluster_mem_total_bytes{cluster=\"$cluster\"})",
          "legendFormat": "Ram Total",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "H",
          "expr": "max(vmware_cluster_mem_used_bytes{cluster=\"$cluster\"}) / max(vmware_cluster_mem_total_bytes{cluster=\"$cluster\"}) * 100",
          "legendFormat": "Ram Used",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "I",
          "expr": "max(vmware_cluster_vsan_capacity_bytes{cluster=\"$cluster\"})",
          "legendFormat": "vSAN Total",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "J",
          "expr": "(max(vmware_cluster_vsan_capacity_bytes{cluster=\"$cluster\"}) - max(vmware_cluster_vsan_free_bytes{cluster=\"$cluster\"})) / max(vmware_cluster_vsan_capacity_bytes{cluster=\"$cluster\"}) * 100",
          "legendFormat": "vSAN Used",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "K",
          "expr": "max(vmware_cluster_vsan_free_bytes{cluster=\"$cluster\"})",
          "legendFormat": "vSAN Free",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "L",
          "expr": "max(vmware_cluster_vsan_resync_bytes{cluster=\"$cluster\"})",
          "legendFormat": "vSAN Resync",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "M",
          "expr": "max(vmware_cluster_host_uptime_max_seconds{cluster=\"$cluster\"}) / 86400",
          "legendFormat": "Host - Uptime",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "N",
          "expr": "max(vmware_cluster_host_cpu_max_percent{cluster=\"$cluster\"})",
          "legendFormat": "CPU Host (Max)",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "O",
          "expr": "max(vmware_cluster_host_mem_max_percent{cluster=\"$cluster\"})",
          "legendFormat": "RAM Host (Max)",
          "instant": true,
          "range": false
        }
      ],

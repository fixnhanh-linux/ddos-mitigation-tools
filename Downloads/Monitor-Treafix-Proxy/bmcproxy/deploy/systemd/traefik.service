[Unit]
Description=Traefik - Treafix Proxy BB
After=network-online.target bmcproxy-agent.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/traefik --configFile=/etc/traefik/traefik.yml
Restart=on-failure
RestartSec=3
# Cho phep mo cong < 1024 (vd 443) ma khong chay bang root
User=traefik
Group=traefik
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/log/traefik
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
